# Maintainer: hakergeniusz <radix@users.noreply.github.com>
# Radix — independent desktop calculator (clean-room implementation).

pkgname=radix
pkgver=0.1.0
pkgrel=1
pkgdesc="An independent desktop calculator"
arch=('x86_64' 'aarch64')
url="https://github.com/hakergeniusz/radix"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib-networking')
makedepends=('cargo' 'rust')
source=("radix-$pkgver.tar.gz")
sha256sums=('SKIP')  # CI pins the release-archive checksum; local builds may keep SKIP
options=('!lto')  # makepkg LTO breaks ring's asm at release link

prepare() {
  cd "radix-$pkgver"
  cargo fetch --locked
}

build() {
  cd "radix-$pkgver"
  cargo build --release --locked
}

check() {
  cd "radix-$pkgver"
  cargo test --locked
}

package() {
  cd "radix-$pkgver"
  install -Dm755 target/release/radix "$pkgdir/usr/bin/radix"
  install -Dm644 data/io.github.hakergeniusz.Radix.desktop.in \
    "$pkgdir/usr/share/applications/io.github.hakergeniusz.Radix.desktop"
  install -Dm644 data/io.github.hakergeniusz.Radix.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.hakergeniusz.Radix.metainfo.xml"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "data/icons/hicolor/${s}x${s}/apps/io.github.hakergeniusz.Radix.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/io.github.hakergeniusz.Radix.png"
  done
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.hakergeniusz.Radix.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Radix.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/radix/LICENSE"
}
